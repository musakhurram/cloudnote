# Copy this file to .env and fill in your values.
# This file is for the FRONTEND (React app). Create it in the project root.

# URL of your deployed backend API (no trailing slash).
# Example: https://cloudnote-api.onrender.com
# If left empty, the app calls the same origin it is served from.
REACT_APP_API_URL=

# Google OAuth client ID for the frontend.
# Create one at https://console.cloud.google.com/apis/credentials
# (Application type: Web application; add your frontend URL to
#  "Authorized JavaScript origins" and your backend URL to
#  "Authorized redirect URIs").
REACT_APP_GOOGLE_CLIENT_ID=
