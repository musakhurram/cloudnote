# Copy this file to backend/.env and fill in your values.

# MongoDB connection string.
# Local: mongodb://localhost:27017/cloudnote
# Production (MongoDB Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cloudnote
MONGO_URI=

# JWT signing secret — use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google OAuth client ID (same value as REACT_APP_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Port the backend listens on. Leave empty to use the platform default
# (Render/Railway assign one automatically) or 5000 locally.
PORT=

# Allowed frontend origin for CORS (no trailing slash).
# Example: https://cloudnote.vercel.app
# Leave empty to allow all origins (local development only).
CORS_ORIGIN=
